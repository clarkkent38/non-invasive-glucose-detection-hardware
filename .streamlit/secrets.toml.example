# ============================================================
# .streamlit/secrets.toml.example
# ============================================================
# Copy this file to .streamlit/secrets.toml and fill in your
# real Supabase credentials.  secrets.toml is in .gitignore
# and must NEVER be committed to version control.
#
# Where to find these values:
#   Supabase Dashboard → Your Project → Project Settings → API
#   - "Project URL"          → paste as url below
#   - "anon / public" key    → paste as key below
# ============================================================

[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
key = "YOUR_ANON_PUBLIC_KEY_STARTS_WITH_eyJ"

# ── Streamlit Cloud deployment ─────────────────────────────
# In the Streamlit Cloud dashboard:
#   Your app → Settings → Secrets → paste the block below:
#
# [supabase]
# url = "https://YOUR_PROJECT_REF.supabase.co"
# key = "YOUR_ANON_PUBLIC_KEY_STARTS_WITH_eyJ"
