# =============================================================================
# .streamlit/secrets.toml.example
# =============================================================================
# This file shows the STRUCTURE and has the real non-secret Supabase values
# already filled in. Copy it to .streamlit/secrets.toml to use locally.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is in .gitignore and will never be committed.
#
# NOTE: The anon/public key below is safe to use in client-side code.
#       NEVER put your Supabase secret key (sb_secret_...) in any file
#       that gets committed or shared.
# =============================================================================

[supabase]
url = "https://mjcwhnkyojfaezydvpsp.supabase.co"
key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1qY3dobmt5b2pmYWV6eWR2cHNwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk4NzA5MTYsImV4cCI6MjEwNTQ0NjkxNn0.G1nM1QYYztA2DStOOQ2qOD2Y7RP2n4KnaQKYe1WeVFM"

# =============================================================================
# Streamlit Cloud deployment
# =============================================================================
# In the Streamlit Cloud dashboard:
#   Your app → ⋮ (menu) → Settings → Secrets
# Paste exactly this block (the two lines inside [supabase]):
#
# [supabase]
# url = "https://mjcwhnkyojfaezydvpsp.supabase.co"
# key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1qY3dobmt5b2pmYWV6eWR2cHNwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk4NzA5MTYsImV4cCI6MjEwNTQ0NjkxNn0.G1nM1QYYztA2DStOOQ2qOD2Y7RP2n4KnaQKYe1WeVFM"
